# Rust build output (workspace target dir; iKode also builds to D:/Projects/Target)
/target/
**/target/

# rustfmt / debug artifacts
**/*.rs.bk
*.pdb

# iKode derived state (rebuildable cache — safe to delete; keep config.toml & ikode.md)
.ikode/graph.log*
.ikode/embeddings/
.ikode/tesseract/
.ikode/plan/
.ikode/sessions/
.ikode/goals.json

# iKode local, machine-specific settings (mode + allow/deny rules)
.ikode/settings.local.json

# Claude Code local (machine-specific) settings — keep shared .claude/ config tracked
.claude/settings.local.json

# Environment / secrets
.env
.env.*
.ikenv
.ikenv.*
*.key
*.pem

# Editor / IDE
.idea/
.junie/
.vs/
*.iml
*.swp
*~

# OS cruft
.DS_Store
**/.DS_Store
Thumbs.db
desktop.ini
